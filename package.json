{
  "name": "my-house-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "templates": "node scripts/build-templates.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "idb": "8.0.4",
    "immer": "11.2.9",
    "jspdf": "4.2.1",
    "lucide-react": "1.66.0",
    "nanoid": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg2pdf.js": "2.9.0",
    "zod": "4.6.7",
    "zustand": "5.0.16",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0"
  }
}
